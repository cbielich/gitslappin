# Copy to .env (never commit .env) and edit. GitSlappin's Docker mode reads these.

# Access token, at least 32 characters. The placeholder below is refused.
# Generate one (this prints to the terminal only, it writes no file):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITSLAPPIN_TOKEN=change-me-to-a-long-random-token-0000

# Identity for commits made in the container.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Copy your Windows value: git config --global core.autocrlf   (true, input or false). Leave empty to use git's default.
GITSLAPPIN_AUTOCRLF=true

# Folder mounted read-write at /repos. Forward slashes.
REPOS_DIR=C:/repos

# Your SSH folder (private keys id_* and known_hosts), mounted read-only. Required.
SSH_DIR=C:/Users/you/.ssh

# Port on 127.0.0.1 (same inside and outside the container).
GITSLAPPIN_PORT=4417
